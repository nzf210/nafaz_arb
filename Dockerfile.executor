FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# The executor never needs root privileges at runtime. Runtime configuration
# and exchange credentials are mounted/injected by the deployment environment;
# they must not be copied into the image layers.
RUN groupadd --system appgroup \
    && useradd --system --gid appgroup --create-home appuser

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=appuser:appgroup executor/ ./executor/

USER appuser

CMD ["python", "-m", "executor.main"]

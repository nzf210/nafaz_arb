FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

ARG APP_UID=1000
ARG APP_GID=1000

# The executor never needs root privileges at runtime. Runtime configuration
# and exchange credentials are mounted/injected by the deployment environment;
# they must not be copied into the image layers.
RUN groupadd --system --gid ${APP_GID} appgroup \
    && useradd --system --uid ${APP_UID} --gid appgroup --create-home appuser

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=appuser:appgroup executor/ ./executor/
COPY --chown=appuser:appgroup scripts/live_readonly_preflight.py ./scripts/live_readonly_preflight.py

USER appuser

CMD ["python", "-m", "executor.main"]
